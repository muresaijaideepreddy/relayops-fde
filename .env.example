# Offline demonstration: synthetic data, deterministic analysis, no paid API calls.
DEMO_MODE=true
AI_PROVIDER=demo
DATABASE_URL=sqlite:///./relayops.db

# Live provider is opt-in. Select a Responses-compatible structured-output model.
# Do not put the provider key in frontend files or commit a real .env file.
OPENAI_API_KEY=
OPENAI_MODEL=

# When DEMO_MODE=false, supply tenant keys explicitly (no built-in demo keys).
# TENANT_API_KEYS={"replace-with-a-long-random-key":{"id":"your-tenant","name":"Your company"}}
